datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  severity  String   // INFO, WARNING, ALERT, CRITICAL
  category  String
  assetId   String?
  assetCode String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([severity])
  @@index([createdAt])
}
